# Copie ce fichier en .env.local et renseigne les valeurs.
# .env.local est gitignoré et reste sur ta machine.
# En production (Vercel/autre), configure ces variables dans le dashboard de la plateforme.

# Clé API Resend pour l'envoi des emails du formulaire de contact.
# Obtiens-la sur https://resend.com/api-keys
RESEND_API_KEY=
